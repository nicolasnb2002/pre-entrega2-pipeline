# Copiá este archivo a .env y completalo solo si vas a usar un modelo de verdad.
# Sin claves, python demo.py entra en MODO DEMOSTRACIÓN y no llama a ninguna API.
#
# LLM_PROVIDER elige el proveedor: openai, anthropic o demo.
# demo fuerza el modelo falso. Si ponés openai o anthropic y la clave
# está vacía, demo.py también se queda en el modelo falso.

LLM_PROVIDER=demo
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcional. Si no están, el código usa estos mismos valores (no verificados contra cuenta real).
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-5-5

# Opcional. Vacía = la URL oficial de OpenAI.
# Con una URL compatible con OpenAI se usa otro proveedor con el mismo ChatOpenAI.
OPENAI_BASE_URL=

# Opcional. Tope de tokens de salida (por defecto 512).
LLM_MAX_TOKENS=512

# ---------------------------------------------------------------------------
# GRATIS con Gemini (Google AI Studio). Clave: https://aistudio.google.com/apikey
# LLM_PROVIDER=openai
# OPENAI_API_KEY=pegá_acá_la_clave_de_gemini
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-3.5-flash-lite
# LLM_MAX_TOKENS=2048
#
# GRATIS con Groq. Clave: https://console.groq.com/keys
# LLM_PROVIDER=openai
# OPENAI_API_KEY=pegá_acá_la_clave_de_groq
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-20b
# LLM_MAX_TOKENS=2048
